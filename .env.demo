# AI_LAWYER — шаблон для демонстрации (contracts + review)
# Скопируйте в .env и подставьте секреты:
#   copy .env.demo .env   (Windows: copy .env.demo .env)
#
# Запуск бота (из корня репозитория):
#   set PYTHONPATH=%CD%
#   python -m app.bot.main
# PowerShell:
#   $env:PYTHONPATH=(Get-Location).Path; python -m app.bot.main

# --- обязательно для демо ---
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# --- модель (безопасные дефолты для демо: баланс скорости и длины) ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_RETRIES=6

# Договор: достаточно объёма за 4 чанка
OPENAI_NUM_CHUNKS=4
OPENAI_MAX_OUTPUT_TOKENS=2200
OPENAI_CONTEXT_KEEP_CHARS=18000

# Добор длины, если текст чуть не дотянул до порога
CONTRACT_EXTEND_MAX_ROUNDS=2
CONTRACT_EXTEND_MAX_OUTPUT_TOKENS=4096
# При необходимости ослабить жёсткий порог (0 = выкл., до 0.35)
CONTRACT_LENGTH_GATE_RELAX=0

# Анализ договора: короче и меньше «воды»
# Один чанк по умолчанию — меньше повторов и «второй волны» заключения
ANALYZE_NUM_CHUNKS=1
ANALYZE_MAX_OUTPUT_TOKENS=2400
ANALYZE_MIN_OUTPUT_CHARS=420
# Короткий релевантный shortlist в промпт и в нижний RAG-блок (не весь retriever)
ANALYZE_RAG_TOP_FOR_PROMPT=14
ANALYZE_RAG_NOISE_TITLE_MIN_SCORE=4
ANALYZE_RAG_SUMMARY_MAX_LINES=14
ANALYZE_RAG_SUMMARY_MAX_CHARS=2200
# Обычная поставка без ВЭД: ослабить НК/ТК в shortlist (мультипликаторы частичного score)
# ANALYZE_SUPPLY_DOMESTIC_NK_MULT=0.52
# ANALYZE_SUPPLY_DOMESTIC_CUSTOMS_MULT=0.22
# ANALYZE_SUPPLY_DOMESTIC_CURRENCY_MULT=0.48
# ANALYZE_SUPPLY_DOMESTIC_LABOR_MULT=0.35
# ANALYZE_SUPPLY_DOMESTIC_GK_BONUS=3

# Short intake (если поддерживается intake_config)
# CONTRACT_USE_SHORT_INTAKE=1

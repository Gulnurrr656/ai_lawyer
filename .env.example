# ZangerPro AI — web environment example.
# Copy to .env and fill in. The web app starts WITHOUT BOT_TOKEN.

APP_ENV=development
WEB_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-please-generate-a-long-random-string

# Storage
DATABASE_URL=sqlite:///var/zangerpro.db
ZANGERPRO_DB_PATH=
STORAGE_DIR=exports
UPLOAD_DIR=var/uploads

# OpenAI (optional; web works without it via skeleton/fallback mode)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STT_MODEL=whisper-1
AI_LAWYER_FAKE_LLM=

# Payments
# Primary providers in the web UI: Freedom Pay + Halyk ePay (and Halyk PayLink).
# Mock surfaces only when APP_ENV != production.
# Kaspi is kept as a legacy admin-confirm path and is NOT shown in the UI.
PAYMENT_MODE=mock
HALYK_PROVIDER_MODE=mock

# Freedom Pay (live)
FREEDOM_PAY_MERCHANT_ID=
FREEDOM_PAY_SECRET=

# Halyk PayLink (live)
PAYLINK_SHOP_ID=
PAYLINK_SECRET_KEY=

# Halyk ePay (live)
HALYK_EPAY_TERMINAL=
HALYK_EPAY_SECRET=

# Admin bootstrap (optional). When present, the user is created on first
# start and promoted to role=admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

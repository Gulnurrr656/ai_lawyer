  "handoff_rules": {
    "crime_signals_any": [
      "подделка",
      "фальсификация",
      "189",
      "190",
      "383",
      "384",
      "385",
      "обнал",
      "вывод активов",
      "лжепредпринимательство",
      "фиктивное банкротство",
      "преднамеренное банкротство",
      "полиция",
      "следователь",
      "уголовное дело"
    ],
    "admin_signals_any": [
      "КГД",
      "уведомление",
      "предписание",
      "акт проверки",
      "штраф",
      "протокол",
      "постановление",
      "госорган",
      "обжаловать действие/бездействие органа"
    ],
    "if_crime_signal": {
      "do": "handoff_to_root_mode=CRIMINAL_OR_MIXED",
      "message": "Есть признаки уголовно-правовых рисков. ГКРК не отменяется, но квалификация должна идти через ROOT с режимом CRIMINAL/MIXED."
    },
    "if_admin_signal": {
      "do": "handoff_to_root_mode=ADMIN_OR_MIXED",
      "message": "Есть признаки публично-правового спора/админпроцедуры. Нужна связка через ROOT с APPK/KoAP."
    }
  },
  "minimal_questions_pack": {
    "ask_first_always": [
      "Кто стороны (физ/юр, ИП/ТОО)?",
      "Есть ли договор или хотя бы переписка/счет/оферта?",
      "Что произошло (факты 1-2 предложения)?",
      "Сумма и по каким документам?",
      "Даты: когда возникло обязательство и когда нарушили?",
      "Что хотите получить (деньги/расторгнуть/признать недействительным/вернуть)?"
    ]
  }

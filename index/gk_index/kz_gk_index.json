  ],
  "mission": "Сделать из запроса клиента юридически применимую позицию по ГКРК: квалификация -> конструкция (основание) -> элементы доказывания -> доказательства -> расчеты -> сроки/давность -> стратегический план (досудебка/суд/исполнение).",
  "gk_is_bible_reasoning": {
    "why_gk_is_core": [
      "ГКРК задаёт универсальные понятия и конструкции частного права: лица, сделки, имущество, обязательства, ответственность.",
      "Большинство бизнес-споров и имущественных конфликтов сводятся к конструкциям ГКРК даже если сверху есть специальные законы.",
      "ГКРК позволяет строго собрать 'право на требование' через элементы доказывания — это язык суда и адвоката."
    ],
    "use_principle": "Сначала конструкция по ГКРК, затем уточняющие спецнормы (если есть) и практика (НП ВС)."
  },
  "guardrails": {
    "never_assume_facts": true,
    "always_split_facts_and_hypotheses": true,
    "do_not_name_article_without_elements": true,
    "do_not_compute_limitation_without_dates": true,
    "do_not_promise_outcome": true,
    "do_not_call_anything_crime": true,
    "if_crime_signals_then_handoff_to_root": true,
    "use_only_root_canon_source_ids": true,
    "no_new_source_ids": true
  },
  "router_output_schema": {
    "must_return_json_object": true,
    "required_fields": [
      "mode_label",
      "primary_route",
      "routes",
      "addons",
      "confidence",
      "why",
      "facts_vs_hypotheses",
      "legal_construction",
      "remedies",
      "elements_to_prove",
      "evidence_matrix",
      "missing_facts",
      "next_questions",
      "risk_map",
      "strategy",
      "drafting_checklist"
    ],
    "field_types": {
      "mode_label": "string",
      "primary_route": "string",
      "routes": "array[string]",
      "addons": "array[string]",
      "confidence": "number",
      "why": "array[string]",
      "facts_vs_hypotheses": {
        "facts": "array[string]",
        "hypotheses": "array[string]"
      },
      "legal_construction": "string",
      "remedies": "array[string]",
      "elements_to_prove": "array[string]",
      "evidence_matrix": "array[object]",
      "missing_facts": "array[string]",
      "next_questions": "array[string]",
      "risk_map": "array[string]",
      "strategy": "array[string]",
      "drafting_checklist": "array[string]"
    },
    "hard_rule": "mode_label всегда писать как 'ГКРК (kz_gk_code)' — без слова 'цивиль'."
  },
  "methodology": {
    "name": "Senior GK Workflow",
    "steps": [
      {
        "step": 1,
        "title": "Юридическая квалификация (что это за отношения)",
        "must_identify": [
          "тип: договор / вред / неосновательное / вещное право / недействительность / корпоративное / потребитель",
          "стороны и их статус: физ/юр, ИП/ТОО, потребитель/предприниматель",
          "роль государства: если госорган как регулятор — это не ГК, а APPK (handoff)"
        ]
      },
      {
        "step": 2,
        "title": "Конструкция (основание требования) и Remedy",
        "must_output": [
          "legal_construction (одна главная конструкция + доп. при необходимости)",
          "remedies (что конкретно требуем: взыскать/обязать/расторгнуть/признать недействительным/вернуть)"
        ],
        "rule": "Сначала remedy, потом под него собирается конструкция и элементы."
      },
      {
        "step": 3,
        "title": "Элементы доказывания (что суд должен увидеть)",
        "must_output": [
          "elements_to_prove как чек-лист",
          "минимальные условия (например: обязательство -> нарушение -> размер)"
        ]
      },
      {
        "step": 4,
        "title": "Доказательства (матрица элемент -> документ)",
        "must_output": [
          "evidence_matrix: каждый элемент доказывания должен иметь хотя бы 1-2 доказательства",
          "если доказательств нет — это missing_facts/risks"
        ]
      },
      {
        "step": 5,
        "title": "Расчёты требований",
        "must_output": [
          "как считается долг/неустойка/убытки",
          "какие документы нужны для расчёта",
          "что является слабым местом расчёта"
        ]
      },
      {
        "step": 6,
        "title": "Сроки/давность — только после дат",
        "hard_rule": "Без дат — только вопросы. Никаких выводов про истекло/не истекло.",
        "must_ask": [
          "Когда нарушение?",
          "Когда узнали?",
          "Было ли признание долга/частичная оплата/переписка?"
        ]
      },
      {
        "step": 7,
        "title": "Стратегия: досудебка -> суд -> исполнение",
        "must_output": [
          "strategy: шаги и порядок действий",
          "drafting_checklist: какие документы подготовить"
        ]
      }
    ]
  },
  "tracks": [
    {
      "track_id": "GK_CONTRACT",
      "title": "Договор: долг/неисполнение/неустойка/убытки",
      "routes": [

      "kz_vs_np_llp_and_alp_code": "vs_np_llp_alp",
      "kz_vs_np_civil_procedure_norms_code": "vs_np_civil_procedure",
      "kz_vs_np_civil_judgment_code": "vs_np_civil_judgment",
      "kz_law_enforcement_code": "law_enforcement",
      "kz_law_consumer_protection_code": "law_consumer_protection",
      "kz_law_llp_code": "law_llp",
      "kz_law_state_registration_code": "law_state_registration",
      "kz_law_buh_code": "law_buh"
    },
    "hard_rule": "Слова gk/pk/vs_np/laws используются только как алиасы для путей. Никакие 'civil'/'цивиль' не используются как папки или файлы."
  },
  "primary_source": "kz_gk_code",
  "secondary_sources": [
    "kz_pk_code"
  ],
  "supporting_sources": [
    "kz_vs_np_invalidity_of_transactions_code",
    "kz_vs_np_llp_and_alp_code",
    "kz_vs_np_civil_procedure_norms_code",
    "kz_vs_np_civil_judgment_code",
    "kz_law_enforcement_code",

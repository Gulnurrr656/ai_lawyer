  "routing_rules": {
    "default_entry_point": "kz_gk_code",
    "codes_have_priority_over_laws": true,
    "supreme_court_norms_are_explanatory": true,
    "multiple_sources_allowed": true,
    "never_use_unknown_sources": true,
    "never_use_sources_outside_canon_sources": true,
    "never_invent_source_ids": true,
    "hard_boundary_rules": [
      "АППК (kz_appc_code) = публично-правовые споры с госорганом: акт/действие/бездействие, оспаривание, административная жалоба/админ.иск.",
      "КоАП (kz_koap_code) = административная ответственность: протокол/постановление/штраф, состав правонарушения, санкции.",
      "НК (kz_nk_code) = налоговая материальная база и администрирование; АППК подключается как процедура защиты по спору с КГД.",
      "УК (kz_uk_code) = уголовная плоскость: только признаки/риски/гипотезы; нельзя утверждать 'это уголовка' без фактов и состава.",
      "ГК/ПК (kz_gk_code/kz_pk_code) = гражданско-правовая плоскость: договоры/обязательства/убытки/неустойка, предпринимательские отношения."
    ]
  },
  "modes_priority": [
    "CRIMINAL",
    "ADMIN",
    "TAX",
    "CIVIL",
    "PROCESS",
    "MIXED"
  ],
  "decision_engine": {
    "method": "weighted_scoring_with_hard_triggers",
    "confidence_scale": "0-100",
    "hard_trigger_priority": [
      "CRIMINAL"
    ],
    "conflict_rule": "If CRIMINAL hard triggers fire -> mode=CRIMINAL even if other modes score high",
    "router_output_schema": {
      "must_return_json_object": true,
      "fields_required": [
        "mode",
        "mode_label",
        "primary_route",
        "routes",
        "addons",
        "confidence",
        "why",
        "missing_facts",
        "next_questions",
        "facts_vs_hypotheses",
        "safety_notes"
      ],
      "field_types": {
        "mode": "string",
        "mode_label": "string",
        "primary_route": "string",
        "routes": "array[string]",
        "addons": "array[string]",
